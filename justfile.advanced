set shell := ["bash", "-cu"]
set export

import "common.just"

# Advanced generation profile: configured multi-stage runs.
PROGRAM_ID := "inc"
STUDY_ID := "brainpowers"
PIPELINE_STAGES := "src int program"
MODELS_STAGE_ROOT := "include_kf_dbt_harmonization/models/include"

DD_FORMAT := "ftd_dd"
SOURCE_SCHEMA := ""  # empty -> <program_id>_<study_id>_raw
SRC_MATERIALIZED := "table"
FROM_CLAUSE_TEMPLATE := ""
SQL_REFERENCE_DIR := ""
VERSION_LOG := "pipeline_docs/access_version_log.log"

# Inputs to generation: local DD paths and/or in-memory release assets.
RELEASE_ASSETS := ""
SRC_RELEASE_ASSETS := ""
INT_RELEASE_ASSETS := ""
PROGRAM_RELEASE_ASSETS := "inc|project-artifacts.zip"
COMMON_RELEASE_ASSETS := "common|project-artifacts.zip"
RELEASE_TAG := "latest"
RELEASE_TOKEN := ""
REFRESH := ""

# Stage DD directories can be empty when using release assets.
SRC_DD_DIR := "../_study_data/include/brainpower/"
INT_DD_DIR := ""
PROGRAM_DD_DIR := ""
COMMON_DD_DIR := ""

# Optional stage-specific output directory overrides. Defaults to: <MODELS_STAGE_ROOT>/<study_id>/<stage>
SRC_STAGE_DIR := ""
INT_STAGE_DIR := ""
PROGRAM_STAGE_DIR := "include_kf_dbt_harmonization/models/include/_inc_program"
COMMON_STAGE_DIR := "include_kf_dbt_harmonization/models/access/combined_common"

# Optional stage-specific table-prefix overrides.
# When unset, defaults to: <program_id>_<study_id>_<stage>
SRC_TABLE_PREFIX_STAGE := ""
INT_TABLE_PREFIX_STAGE := ""
PROGRAM_TABLE_PREFIX_STAGE := "inc_program"
COMMON_TABLE_PREFIX_STAGE := "combined_common"

# Program-stage SQL is a union of the studies listed in this dbt var.
# When unset, defaults to: <program_id>_studies
STUDIES_VAR := env("STUDIES_VAR", "")
# Combined common-stage SQL unions the common CDM sets listed in this dbt var.
COMMON_STUDIES_VAR := "common_access_data"

# Access model sets (generate-access): output root and optional from-clause override.
# Empty ACCESS_FROM_CLAUSE_TEMPLATE uses {{ ref('<PROGRAM_TABLE_PREFIX_STAGE>_{base_name}') }}.
ACCESS_MODELS_ROOT := "include_kf_dbt_harmonization/models/access"
ACCESS_FROM_CLAUSE_TEMPLATE := ""

# Direct-usage pass-through vars for the compatibility wrapper recipes below.
# TABLE_PREFIX also falls back to the environment so `TABLE_PREFIX=... just ...` still works.
TABLE_PREFIX := env("TABLE_PREFIX", "")
DD_DIR := ""
MODELS_YML := ""
MODELS_DOCS := ""
SOURCES_YML := ""
SOURCES_DOCS := ""
SOURCE_NAME := ""
SQL_DIR := ""
SRC_SQL_DIR := ""
SRC_SOURCE_NAME := ""

default:
    @just --list

help:
    @just --list --unsorted
    @printf '%s\n' '' 'Advanced generation examples (csv path and/or in-memory releases):' \
        '  just -f justfile.advanced STUDY_ID=brainpower generate-stage src' \
        '  just -f justfile.advanced STUDY_ID=brainpower generate-all-stages' \
        '  just -f justfile.advanced STUDY_ID=brainpower generate-pipeline-sql' \
        '  just -f justfile.advanced generate-access access' \
        '  just -f justfile.advanced generate-access common' \
        '  just -f justfile.advanced generate-include-pipeline' \
        '  just -f justfile.advanced PIPELINE_STAGES="src int program access access_common common" generate-all-stages' \
        '  just -f justfile.advanced PIPELINE_STAGES="src int" SRC_DD_DIR="" INT_DD_DIR="" SRC_RELEASE_ASSETS="inc|project-artifacts.zip" INT_RELEASE_ASSETS="kf|project-artifacts.zip" generate-all-stages' \
        '  just -f justfile.advanced SRC_DD_DIR="" SRC_RELEASE_ASSETS="inc|project-artifacts.zip" generate-stage src' \
        '  just -f justfile.advanced generate-stage common' \
        '  just -f justfile.advanced INT_TABLE_PREFIX_STAGE=inc_brainpower_int generate-stage-model-sql int' \
        '' \
        'Refresh from GitHub releases is handled in justfile.access only:' \
        '  just -f justfile.access help'

_resolve_stage_env := '
    stage="$STAGE_INPUT"
    study_id="$STUDY_ID"

    case "$stage" in
        src)
            stage_dd_dir="$SRC_DD_DIR"
            stage_release_assets="${SRC_RELEASE_ASSETS:-$RELEASE_ASSETS}"
            stage_dir_override="$SRC_STAGE_DIR"
            stage_table_prefix_override="$SRC_TABLE_PREFIX_STAGE"
            ;;
        int)
            stage_dd_dir="${INT_DD_DIR:-$SRC_DD_DIR}"
            stage_release_assets="${INT_RELEASE_ASSETS:-$RELEASE_ASSETS}"
            stage_dir_override="$INT_STAGE_DIR"
            stage_table_prefix_override="$INT_TABLE_PREFIX_STAGE"
            ;;
        program)
            stage_dd_dir="$PROGRAM_DD_DIR"
            stage_release_assets="${PROGRAM_RELEASE_ASSETS:-$RELEASE_ASSETS}"
            stage_dir_override="$PROGRAM_STAGE_DIR"
            stage_table_prefix_override="$PROGRAM_TABLE_PREFIX_STAGE"
            ;;
        access|access_common)
            stage_dd_dir=""
            if [[ "$stage" == access ]]; then stage_release_assets="$PROGRAM_RELEASE_ASSETS"; else stage_release_assets="$COMMON_RELEASE_ASSETS"; fi
            access_name="${PROGRAM_ID}_${stage#access_}"
            if [[ "$stage" == access ]]; then access_name="${PROGRAM_ID}_access"; fi
            stage_dir_override="$ACCESS_MODELS_ROOT/$access_name"
            stage_table_prefix_override="$access_name"
            ;;
        common)
            stage_dd_dir="$COMMON_DD_DIR"
            stage_release_assets="${COMMON_RELEASE_ASSETS:-$RELEASE_ASSETS}"
            stage_dir_override="$COMMON_STAGE_DIR"
            stage_table_prefix_override="$COMMON_TABLE_PREFIX_STAGE"
            ;;
        *)
            echo "Unknown stage: $stage (expected: src|int|program|access|access_common|common)" >&2
            exit 2
            ;;
    esac

    if [[ -z "$stage_dd_dir" && -z "$stage_release_assets" ]]; then
        echo "Set ${stage^^}_DD_DIR or ${stage^^}_RELEASE_ASSETS before running stage $stage." >&2
        exit 2
    fi

    if [[ -n "$stage_dd_dir" && ! -e "$stage_dd_dir" ]]; then
        if [[ -n "$stage_release_assets" ]]; then
            stage_dd_dir=""
        else
            echo "Configured DD path does not exist for stage $stage: $stage_dd_dir" >&2
            exit 2
        fi
    fi

    if [[ -d "$stage_dd_dir" && -z "$stage_release_assets" ]]; then
        shopt -s nullglob nocaseglob
        dd_files=("$stage_dd_dir"/*_dd.csv "$stage_dd_dir"/*-dd.csv "$stage_dd_dir"/*_dictionary.csv "$stage_dd_dir"/*-dictionary.csv "$stage_dd_dir"/*_dd.xlsx "$stage_dd_dir"/*-dd.xlsx "$stage_dd_dir"/*_dictionary.xlsx "$stage_dd_dir"/*-dictionary.xlsx)
        if (( ${#dd_files[@]} == 0 )); then
            echo "No DD files found in $stage_dd_dir for stage $stage." >&2
            exit 2
        fi
    fi

    default_stage_dir="$MODELS_STAGE_ROOT/$study_id/$stage"
    stage_dir="${stage_dir_override:-$default_stage_dir}"

    default_stage_table_prefix="${PROGRAM_ID}_${study_id}_${stage}"
    if [[ -n "$stage_table_prefix_override" ]]; then
        stage_table_prefix="$stage_table_prefix_override"
    else
        stage_table_prefix="$default_stage_table_prefix"
    fi

    stage_models_yml="$stage_dir/_models.yml"
    stage_models_docs="$stage_dir/_column_descriptions.md"
    stage_sources_yml="$stage_dir/_sources.yml"
    stage_sources_docs="$stage_dir/_column_descriptions.md"
    stage_sql_dir="$stage_dir"
    stage_src_sql_dir="$stage_dir"
    stage_studies_var="${STUDIES_VAR:-${PROGRAM_ID}_studies}"
    if [[ "$stage" == common ]]; then stage_studies_var="$COMMON_STUDIES_VAR"; fi
    if [[ "$stage" == program || "$stage" == common ]]; then stage_sql_recipe=_gen_stb_union_sql; else stage_sql_recipe=_gen_model_sql; fi

    # Derived names shared with the basic justfile; explicit values win.
    name_base="${PROGRAM_ID}_${study_id}"
    src_prefix="${SRC_TABLE_PREFIX_STAGE:-${name_base}_src}"
    if [[ "$src_prefix" == none ]]; then src_prefix=""; fi
    if [[ "$stage_table_prefix" == none ]]; then stage_table_prefix=""; fi
    stage_source_name="${SRC_SOURCE_NAME:-${name_base}_src}"
    export SOURCE_SCHEMA="${SOURCE_SCHEMA:-${name_base}_raw}"
    q="$(printf "\047")"
    case "$stage" in
        src)
            export SRC_TABLE_PREFIX="$src_prefix"
            stage_table_prefix=""
            ;;
        int)
            if [[ -z "$FROM_CLAUSE_TEMPLATE" ]]; then
                ref_name="{base_name}"
                if [[ -n "$src_prefix" ]]; then ref_name="${src_prefix}_{base_name}"; fi
                export FROM_CLAUSE_TEMPLATE="{{ ref(${q}${ref_name}${q}) }}"
            fi
            ;;
        access|access_common)
            program_prefix="${PROGRAM_TABLE_PREFIX_STAGE:-${PROGRAM_ID}_program}"
            if [[ -z "$ACCESS_FROM_CLAUSE_TEMPLATE" ]]; then
                left_brace="{"
                right_brace="}"
                export FROM_CLAUSE_TEMPLATE="${left_brace}${left_brace} ref(${q}${program_prefix}_{base_name}${q}) ${right_brace}${right_brace}"
            else
                export FROM_CLAUSE_TEMPLATE="$ACCESS_FROM_CLAUSE_TEMPLATE"
            fi
            ;;
    esac
'

# Direct generator wrappers.
generate-models-yml:
    just -f common.just _gen_models

generate-sources-yml:
    just -f common.just _gen_sources

generate-model-sql:
    just -f common.just _gen_model_sql

generate-src-sql:
    just -f common.just _gen_src_sql

generate-stage-models-yml stage:
    #!/usr/bin/env bash
    STAGE_INPUT="{{stage}}"
    {{ _resolve_stage_env }}
    DD_DIR="$stage_dd_dir" \
    RELEASE_ASSETS="$stage_release_assets" \
    TABLE_PREFIX="$stage_table_prefix" \
    MODELS_YML="$stage_models_yml" \
    MODELS_DOCS="$stage_models_docs" \
    just -f common.just _gen_models

generate-stage-sources-yml stage:
    #!/usr/bin/env bash
    STAGE_INPUT="{{stage}}"
    {{ _resolve_stage_env }}
    DD_DIR="$stage_dd_dir" \
    RELEASE_ASSETS="$stage_release_assets" \
    TABLE_PREFIX="$stage_table_prefix" \
    SOURCES_YML="$stage_sources_yml" \
    SOURCES_DOCS="$stage_sources_docs" \
    SOURCE_NAME="$stage_source_name" \
    just -f common.just _gen_sources

generate-stage-model-sql stage:
    #!/usr/bin/env bash
    STAGE_INPUT="{{stage}}"
    {{ _resolve_stage_env }}
    DD_DIR="$stage_dd_dir" \
    RELEASE_ASSETS="$stage_release_assets" \
    TABLE_PREFIX="$stage_table_prefix" \
    SQL_DIR="$stage_sql_dir" \
    STUDIES_VAR="$stage_studies_var" \
    just -f common.just "$stage_sql_recipe"

generate-stage-src-sql stage:
    #!/usr/bin/env bash
    STAGE_INPUT="{{stage}}"
    {{ _resolve_stage_env }}
    DD_DIR="$stage_dd_dir" \
    RELEASE_ASSETS="$stage_release_assets" \
    TABLE_PREFIX="$stage_table_prefix" \
    SRC_SQL_DIR="$stage_src_sql_dir" \
    SRC_SOURCE_NAME="$stage_source_name" \
    just -f common.just _gen_src_sql

generate-stage stage:
    #!/usr/bin/env bash
    STAGE_INPUT="{{stage}}"
    {{ _resolve_stage_env }}

    if [[ "{{stage}}" == "src" ]]; then
        DD_DIR="$stage_dd_dir" \
        RELEASE_ASSETS="$stage_release_assets" \
        TABLE_PREFIX="$stage_table_prefix" \
        SOURCES_YML="$stage_sources_yml" \
        SOURCES_DOCS="$stage_sources_docs" \
        SOURCE_NAME="$stage_source_name" \
        just -f common.just _gen_sources

        DD_DIR="$stage_dd_dir" \
        RELEASE_ASSETS="$stage_release_assets" \
        TABLE_PREFIX="$stage_table_prefix" \
        SRC_SQL_DIR="$stage_src_sql_dir" \
        SRC_SOURCE_NAME="$stage_source_name" \
        just -f common.just _gen_src_sql
    else
        DD_DIR="$stage_dd_dir" \
        RELEASE_ASSETS="$stage_release_assets" \
        TABLE_PREFIX="$stage_table_prefix" \
        MODELS_YML="$stage_models_yml" \
        MODELS_DOCS="$stage_models_docs" \
        just -f common.just _gen_models

        DD_DIR="$stage_dd_dir" \
        RELEASE_ASSETS="$stage_release_assets" \
        TABLE_PREFIX="$stage_table_prefix" \
        SQL_DIR="$stage_sql_dir" \
        STUDIES_VAR="$stage_studies_var" \
        just -f common.just "$stage_sql_recipe"
    fi

generate-all-stages:
    #!/usr/bin/env bash
    for stage in $PIPELINE_STAGES; do
        just -f justfile.advanced \
          PROGRAM_ID="$PROGRAM_ID" STUDY_ID="$STUDY_ID" PIPELINE_STAGES="$PIPELINE_STAGES" MODELS_STAGE_ROOT="$MODELS_STAGE_ROOT" \
          DD_FORMAT="$DD_FORMAT" SOURCE_SCHEMA="$SOURCE_SCHEMA" SRC_MATERIALIZED="$SRC_MATERIALIZED" FROM_CLAUSE_TEMPLATE="$FROM_CLAUSE_TEMPLATE" SQL_REFERENCE_DIR="$SQL_REFERENCE_DIR" VERSION_LOG="$VERSION_LOG" \
          RELEASE_ASSETS="$RELEASE_ASSETS" RELEASE_TAG="$RELEASE_TAG" RELEASE_TOKEN="$RELEASE_TOKEN" REFRESH="$REFRESH" \
          SRC_RELEASE_ASSETS="$SRC_RELEASE_ASSETS" INT_RELEASE_ASSETS="$INT_RELEASE_ASSETS" PROGRAM_RELEASE_ASSETS="$PROGRAM_RELEASE_ASSETS" COMMON_RELEASE_ASSETS="$COMMON_RELEASE_ASSETS" \
          SRC_DD_DIR="$SRC_DD_DIR" INT_DD_DIR="$INT_DD_DIR" PROGRAM_DD_DIR="$PROGRAM_DD_DIR" COMMON_DD_DIR="$COMMON_DD_DIR" \
          SRC_STAGE_DIR="$SRC_STAGE_DIR" INT_STAGE_DIR="$INT_STAGE_DIR" PROGRAM_STAGE_DIR="$PROGRAM_STAGE_DIR" COMMON_STAGE_DIR="$COMMON_STAGE_DIR" \
          SRC_TABLE_PREFIX_STAGE="$SRC_TABLE_PREFIX_STAGE" INT_TABLE_PREFIX_STAGE="$INT_TABLE_PREFIX_STAGE" PROGRAM_TABLE_PREFIX_STAGE="$PROGRAM_TABLE_PREFIX_STAGE" COMMON_TABLE_PREFIX_STAGE="$COMMON_TABLE_PREFIX_STAGE" COMMON_STUDIES_VAR="$COMMON_STUDIES_VAR" ACCESS_MODELS_ROOT="$ACCESS_MODELS_ROOT" ACCESS_FROM_CLAUSE_TEMPLATE="$ACCESS_FROM_CLAUSE_TEMPLATE" SRC_SOURCE_NAME="$SRC_SOURCE_NAME" \
          generate-stage "$stage"
    done

generate-src-stage-sql:
    just -f justfile.advanced STUDY_ID="$STUDY_ID" RELEASE_ASSETS="$RELEASE_ASSETS" SRC_RELEASE_ASSETS="$SRC_RELEASE_ASSETS" INT_RELEASE_ASSETS="$INT_RELEASE_ASSETS" PROGRAM_RELEASE_ASSETS="$PROGRAM_RELEASE_ASSETS" COMMON_RELEASE_ASSETS="$COMMON_RELEASE_ASSETS" RELEASE_TAG="$RELEASE_TAG" RELEASE_TOKEN="$RELEASE_TOKEN" REFRESH="$REFRESH" SRC_DD_DIR="$SRC_DD_DIR" INT_DD_DIR="$INT_DD_DIR" PROGRAM_DD_DIR="$PROGRAM_DD_DIR" COMMON_DD_DIR="$COMMON_DD_DIR" SRC_STAGE_DIR="$SRC_STAGE_DIR" INT_STAGE_DIR="$INT_STAGE_DIR" PROGRAM_STAGE_DIR="$PROGRAM_STAGE_DIR" COMMON_STAGE_DIR="$COMMON_STAGE_DIR" SRC_TABLE_PREFIX_STAGE="$SRC_TABLE_PREFIX_STAGE" INT_TABLE_PREFIX_STAGE="$INT_TABLE_PREFIX_STAGE" PROGRAM_TABLE_PREFIX_STAGE="$PROGRAM_TABLE_PREFIX_STAGE" COMMON_TABLE_PREFIX_STAGE="$COMMON_TABLE_PREFIX_STAGE" COMMON_STUDIES_VAR="$COMMON_STUDIES_VAR" ACCESS_MODELS_ROOT="$ACCESS_MODELS_ROOT" ACCESS_FROM_CLAUSE_TEMPLATE="$ACCESS_FROM_CLAUSE_TEMPLATE" SRC_SOURCE_NAME="$SRC_SOURCE_NAME" generate-stage-src-sql src

generate-int-model-sql:
    just -f justfile.advanced STUDY_ID="$STUDY_ID" RELEASE_ASSETS="$RELEASE_ASSETS" SRC_RELEASE_ASSETS="$SRC_RELEASE_ASSETS" INT_RELEASE_ASSETS="$INT_RELEASE_ASSETS" PROGRAM_RELEASE_ASSETS="$PROGRAM_RELEASE_ASSETS" COMMON_RELEASE_ASSETS="$COMMON_RELEASE_ASSETS" RELEASE_TAG="$RELEASE_TAG" RELEASE_TOKEN="$RELEASE_TOKEN" REFRESH="$REFRESH" SRC_DD_DIR="$SRC_DD_DIR" INT_DD_DIR="$INT_DD_DIR" PROGRAM_DD_DIR="$PROGRAM_DD_DIR" COMMON_DD_DIR="$COMMON_DD_DIR" SRC_STAGE_DIR="$SRC_STAGE_DIR" INT_STAGE_DIR="$INT_STAGE_DIR" PROGRAM_STAGE_DIR="$PROGRAM_STAGE_DIR" COMMON_STAGE_DIR="$COMMON_STAGE_DIR" SRC_TABLE_PREFIX_STAGE="$SRC_TABLE_PREFIX_STAGE" INT_TABLE_PREFIX_STAGE="$INT_TABLE_PREFIX_STAGE" PROGRAM_TABLE_PREFIX_STAGE="$PROGRAM_TABLE_PREFIX_STAGE" COMMON_TABLE_PREFIX_STAGE="$COMMON_TABLE_PREFIX_STAGE" COMMON_STUDIES_VAR="$COMMON_STUDIES_VAR" ACCESS_MODELS_ROOT="$ACCESS_MODELS_ROOT" ACCESS_FROM_CLAUSE_TEMPLATE="$ACCESS_FROM_CLAUSE_TEMPLATE" SRC_SOURCE_NAME="$SRC_SOURCE_NAME" generate-stage-model-sql int

generate-program-model-sql:
    just -f justfile.advanced STUDY_ID="$STUDY_ID" RELEASE_ASSETS="$RELEASE_ASSETS" SRC_RELEASE_ASSETS="$SRC_RELEASE_ASSETS" INT_RELEASE_ASSETS="$INT_RELEASE_ASSETS" PROGRAM_RELEASE_ASSETS="$PROGRAM_RELEASE_ASSETS" COMMON_RELEASE_ASSETS="$COMMON_RELEASE_ASSETS" RELEASE_TAG="$RELEASE_TAG" RELEASE_TOKEN="$RELEASE_TOKEN" REFRESH="$REFRESH" SRC_DD_DIR="$SRC_DD_DIR" INT_DD_DIR="$INT_DD_DIR" PROGRAM_DD_DIR="$PROGRAM_DD_DIR" COMMON_DD_DIR="$COMMON_DD_DIR" SRC_STAGE_DIR="$SRC_STAGE_DIR" INT_STAGE_DIR="$INT_STAGE_DIR" PROGRAM_STAGE_DIR="$PROGRAM_STAGE_DIR" COMMON_STAGE_DIR="$COMMON_STAGE_DIR" SRC_TABLE_PREFIX_STAGE="$SRC_TABLE_PREFIX_STAGE" INT_TABLE_PREFIX_STAGE="$INT_TABLE_PREFIX_STAGE" PROGRAM_TABLE_PREFIX_STAGE="$PROGRAM_TABLE_PREFIX_STAGE" COMMON_TABLE_PREFIX_STAGE="$COMMON_TABLE_PREFIX_STAGE" COMMON_STUDIES_VAR="$COMMON_STUDIES_VAR" ACCESS_MODELS_ROOT="$ACCESS_MODELS_ROOT" ACCESS_FROM_CLAUSE_TEMPLATE="$ACCESS_FROM_CLAUSE_TEMPLATE" SRC_SOURCE_NAME="$SRC_SOURCE_NAME" generate-stage-model-sql program

generate-common-model-sql:
    just -f justfile.advanced STUDY_ID="$STUDY_ID" RELEASE_ASSETS="$RELEASE_ASSETS" SRC_RELEASE_ASSETS="$SRC_RELEASE_ASSETS" INT_RELEASE_ASSETS="$INT_RELEASE_ASSETS" PROGRAM_RELEASE_ASSETS="$PROGRAM_RELEASE_ASSETS" COMMON_RELEASE_ASSETS="$COMMON_RELEASE_ASSETS" RELEASE_TAG="$RELEASE_TAG" RELEASE_TOKEN="$RELEASE_TOKEN" REFRESH="$REFRESH" SRC_DD_DIR="$SRC_DD_DIR" INT_DD_DIR="$INT_DD_DIR" PROGRAM_DD_DIR="$PROGRAM_DD_DIR" COMMON_DD_DIR="$COMMON_DD_DIR" SRC_STAGE_DIR="$SRC_STAGE_DIR" INT_STAGE_DIR="$INT_STAGE_DIR" PROGRAM_STAGE_DIR="$PROGRAM_STAGE_DIR" COMMON_STAGE_DIR="$COMMON_STAGE_DIR" SRC_TABLE_PREFIX_STAGE="$SRC_TABLE_PREFIX_STAGE" INT_TABLE_PREFIX_STAGE="$INT_TABLE_PREFIX_STAGE" PROGRAM_TABLE_PREFIX_STAGE="$PROGRAM_TABLE_PREFIX_STAGE" COMMON_TABLE_PREFIX_STAGE="$COMMON_TABLE_PREFIX_STAGE" COMMON_STUDIES_VAR="$COMMON_STUDIES_VAR" ACCESS_MODELS_ROOT="$ACCESS_MODELS_ROOT" ACCESS_FROM_CLAUSE_TEMPLATE="$ACCESS_FROM_CLAUSE_TEMPLATE" SRC_SOURCE_NAME="$SRC_SOURCE_NAME" generate-stage-model-sql common

generate-pipeline-sql:
    #!/usr/bin/env bash
    for stage in $PIPELINE_STAGES; do
        if [[ "$stage" == src ]]; then
            recipe=generate-stage-src-sql
        else
            recipe=generate-stage-model-sql
        fi
        just -f justfile.advanced \
          PROGRAM_ID="$PROGRAM_ID" STUDY_ID="$STUDY_ID" MODELS_STAGE_ROOT="$MODELS_STAGE_ROOT" \
          DD_FORMAT="$DD_FORMAT" SOURCE_SCHEMA="$SOURCE_SCHEMA" SRC_MATERIALIZED="$SRC_MATERIALIZED" FROM_CLAUSE_TEMPLATE="$FROM_CLAUSE_TEMPLATE" SQL_REFERENCE_DIR="$SQL_REFERENCE_DIR" VERSION_LOG="$VERSION_LOG" \
          RELEASE_ASSETS="$RELEASE_ASSETS" SRC_RELEASE_ASSETS="$SRC_RELEASE_ASSETS" INT_RELEASE_ASSETS="$INT_RELEASE_ASSETS" PROGRAM_RELEASE_ASSETS="$PROGRAM_RELEASE_ASSETS" COMMON_RELEASE_ASSETS="$COMMON_RELEASE_ASSETS" RELEASE_TAG="$RELEASE_TAG" RELEASE_TOKEN="$RELEASE_TOKEN" REFRESH="$REFRESH" \
          SRC_DD_DIR="$SRC_DD_DIR" INT_DD_DIR="$INT_DD_DIR" PROGRAM_DD_DIR="$PROGRAM_DD_DIR" COMMON_DD_DIR="$COMMON_DD_DIR" \
          SRC_STAGE_DIR="$SRC_STAGE_DIR" INT_STAGE_DIR="$INT_STAGE_DIR" PROGRAM_STAGE_DIR="$PROGRAM_STAGE_DIR" COMMON_STAGE_DIR="$COMMON_STAGE_DIR" \
          SRC_TABLE_PREFIX_STAGE="$SRC_TABLE_PREFIX_STAGE" INT_TABLE_PREFIX_STAGE="$INT_TABLE_PREFIX_STAGE" PROGRAM_TABLE_PREFIX_STAGE="$PROGRAM_TABLE_PREFIX_STAGE" COMMON_TABLE_PREFIX_STAGE="$COMMON_TABLE_PREFIX_STAGE" COMMON_STUDIES_VAR="$COMMON_STUDIES_VAR" ACCESS_MODELS_ROOT="$ACCESS_MODELS_ROOT" ACCESS_FROM_CLAUSE_TEMPLATE="$ACCESS_FROM_CLAUSE_TEMPLATE" SRC_SOURCE_NAME="$SRC_SOURCE_NAME" \
          "$recipe" "$stage"
    done

# Access model sets: access -> <PROGRAM_ID>_access, common -> <PROGRAM_ID>_common.
generate-access access_set:
    #!/usr/bin/env bash
    case "{{ access_set }}" in
        access) stage=access ;;
        common) stage=access_common ;;
        *) echo "Unknown access set '{{ access_set }}'. Expected: access|common" >&2; exit 2 ;;
    esac
    just -f justfile.advanced PROGRAM_RELEASE_ASSETS="$PROGRAM_RELEASE_ASSETS" COMMON_RELEASE_ASSETS="$COMMON_RELEASE_ASSETS" PROGRAM_TABLE_PREFIX_STAGE="$PROGRAM_TABLE_PREFIX_STAGE" ACCESS_MODELS_ROOT="$ACCESS_MODELS_ROOT" ACCESS_FROM_CLAUSE_TEMPLATE="$ACCESS_FROM_CLAUSE_TEMPLATE" generate-stage "$stage"

generate-all-access: (generate-access "access") (generate-access "common")

# Regenerate the whole include pipeline in order: study src and int (basic
# justfile), program stage, inc_access and inc_common, then combined_common.
generate-include-pipeline: _include-study-stages (generate-stage "program") generate-all-access (generate-stage "common")

[private]
_include-study-stages:
    just -f justfile PROGRAM_ID="$PROGRAM_ID" STUDY_ID="$STUDY_ID" MODELS_STAGE_ROOT="$MODELS_STAGE_ROOT" PIPELINE_STAGE=src generate-stage
    just -f justfile PROGRAM_ID="$PROGRAM_ID" STUDY_ID="$STUDY_ID" MODELS_STAGE_ROOT="$MODELS_STAGE_ROOT" PIPELINE_STAGE=int generate-stage

clean-dir:
    #!/usr/bin/env bash
    if [[ -d "$SQL_DIR" ]]; then
        find "$SQL_DIR" -type f -name '*_generated.sql' -delete
    fi
